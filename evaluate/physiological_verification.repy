#!/usr/bin/env repycl
import numpy as np
import warnings
warnings.filterwarnings("ignore")

from ohca_predictor.pipeline import OHCAPredictorPipeline
from ohca_predictor.utils.io_utils import WindowSample, create_padded_dataset

# 1. Load the model
pipe = OHCAPredictorPipeline.load("../models/v1/best_checkpoint.weights.h5")

def get_prediction(sample_obj):
    ds = create_padded_dataset([sample_obj], batch_size=1, shuffle=False)
    for batch in ds:
        outputs = pipe.model(batch, training=False)
        # FIXED: Extract scalar explicitly using native .item()
        return float(outputs["ohca_risk"].numpy().item())

# 2. Base Template with standard random noise to keep the tokenizers active
base_kwargs = {
    "ecg": np.random.randn(24050).astype(np.float32) * 0.1,
    "accelerometer": np.random.randn(9620, 3).astype(np.float32) * 0.1,
    "gyroscope": np.random.randn(9620, 3).astype(np.float32) * 0.1,
    "ppg": np.random.randn(9250).astype(np.float32) * 0.1,
    "respiration": np.random.randn(4625).astype(np.float32) * 0.1,
    "spo2": np.random.randn(1850).astype(np.float32) * 0.1,
    "temperature": np.random.randn(185).astype(np.float32) * 0.1,
    "demographics": np.random.randn(24).astype(np.float32),
    "medications": np.random.randn(14).astype(np.float32),
    "comorbidities": np.random.randn(14).astype(np.float32),
    "lab_values": np.random.randn(8).astype(np.float32),
    "patient_id": "verify-001",
    "signal_quality": {"ecg": 1.0},
    "window_start_hours": 0.0,
    "window_duration_hours": 0.05138,
    "ohca_label": 0.0, 
    "event_indicator": 0.0, 
    "time_to_event": 0.0,
    "rhythm": 0,
    "activity_state": 0
}

# 3. Case A: Stable Patient
healthy_patient = WindowSample(
    **{**base_kwargs, "heart_rate": 60.0, "spo2_mean": 98.0, "sbp_mean": 120.0, "dbp_mean": 80.0}
)

# 4. Case B: High Risk (Tachycardia, Hypoxia, Severe Hypotension)
critical_patient = WindowSample(
    **{**base_kwargs, "heart_rate": 155.0, "spo2_mean": 75.0, "sbp_mean": 80.0, "dbp_mean": 45.0}
)

risk_healthy = get_prediction(healthy_patient)
risk_critical = get_prediction(critical_patient)

print("\n" + "="*60)
print("             INDEPENDENT PHYSIOLOGICAL VERIFICATION        ")
print("="*60)
print(f"Healthy Patient Risk : {risk_healthy:.4f}")
print(f"Critical Patient Risk: {risk_critical:.4f}")
print(f"Risk Delta Score     : {abs(risk_critical - risk_healthy):.4f}")
print("="*60)
